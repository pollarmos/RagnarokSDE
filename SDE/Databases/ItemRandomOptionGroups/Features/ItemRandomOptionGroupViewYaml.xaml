<UserControl x:Class="SDE.Databases.ItemRandomOptionGroups.Features.ItemRandomOptionGroupViewYaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Foreground="{DynamicResource TextForeground}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 기본 정보 -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Id"
                       VerticalAlignment="Center"
                       Margin="3"/>

            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Text="{Binding Id, Mode=OneWay}"
                     IsReadOnly="True"
                     Margin="3"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Group"
                       VerticalAlignment="Center"
                       Margin="3"/>

            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding Group,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
                     Margin="3"/>

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="MaxRandom"
                       VerticalAlignment="Center"
                       Margin="3"/>

            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding MaxRandom,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Margin="3"/>

        </Grid>

        <!-- Slots / Options -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Slots -->
            <GroupBox Grid.Column="0"
                      Header="Slots">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot, Mode=TwoWay}" Margin="3">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Slot"  Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Slot,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                                BorderThickness="0"
                                                Background="Transparent"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Options"
                                                Width="90"
                                                DisplayMemberBinding="{Binding OptionCount}"/>

                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="3">
                        <Button Content="Add" Width="70" Margin="2" Click="_buttonAddSlot_Click"/>
                        <Button Content="Delete" Width="70" Margin="2" IsEnabled="{Binding IsSlotSelected}" Click="_buttonDeleteSlot_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Slot Options -->
            <GroupBox Grid.Column="2"
                      Header="Slot Options">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView ItemsSource="{Binding SelectedSlot.Options}" SelectedItem="{Binding SelectedSlot.SelectedOption, Mode=TwoWay}" Margin="3">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Option"
                                    Width="260">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding OptionNames}"
                                                      Text="{Binding Option,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      BorderThickness="0"
                                                      Background="Transparent"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Min" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding MinValue,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}" 
                                            BorderThickness="0"
                                            Background="Transparent"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Max" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding MaxValue,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0"
                                            Background="Transparent"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Param" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Param,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0"
                                            Background="Transparent"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Chance" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Chance,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0"
                                            Background="Transparent"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Description"
                                            Width="300"
                                            DisplayMemberBinding="{Binding Description}"/>

                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="3">
                        <Button Content="Add" Width="70" Margin="2" IsEnabled="{Binding IsSlotSelected}" Click="_buttonAddSlotOption_Click"/>
                        <Button Content="Delete" Width="70" Margin="2" IsEnabled="{Binding SelectedSlot.IsOptionSelected}" Click="_buttonDeleteSlotOption_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Random Options -->
        <GroupBox Grid.Row="4"
                  Header="Random Options">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView ItemsSource="{Binding RandomOptions}" SelectedItem="{Binding SelectedRandomOption, Mode=TwoWay}" Margin="3">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Option"
                                            Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding OptionNames}"
                                                  Text="{Binding Option,
                                                         Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  BorderThickness="0"
                                                  Background="Transparent"/>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Min"
                                        Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding MinValue, Mode=Twoway, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Max"
                                        Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding MaxValue, Mode=Twoway, UpdateSourceTrigger=PropertyChanged}"
                                        BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Param"
                                        Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Param, Mode=Twoway, UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Chance"
                                        Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Chance, Mode=Twoway, UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Description"
                                        Width="300"
                                        DisplayMemberBinding="{Binding Description}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="3">
                    <Button Content="Add" Width="70" Margin="2" Click="_buttonAddRandomOption_Click"/>
                    <Button Content="Delete" Width="70" Margin="2" IsEnabled="{Binding IsRandomOptionSelected}" Click="_buttonDeleteRandomOption_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

    </Grid>

</UserControl>